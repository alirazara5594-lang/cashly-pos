{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // The port the API listens on, wherever it is started from.
  //
  // This used to live only in Properties/launchSettings.json, which Visual Studio and
  // `dotnet run` read but a PUBLISHED build ignores completely. That is why the API came back
  // on 5288 during development and then vanished when run any other way — as a service, from a
  // shortcut, or after a reboot, it was binding the framework default instead.
  //
  // 0.0.0.0 rather than localhost so POS terminals on the LAN can reach the business host.
  // Override per machine in appsettings.Production.json or with the ASPNETCORE_URLS variable.
  "Urls": "http://0.0.0.0:5288",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=cashly_pos_db;Username=postgres;Password=12345678"
  }
}
