<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Guardrails: these two were fixed at root and must never silently return.
         NU1903 = the Microsoft.OpenApi advisory class (bumping back to a vulnerable version fails the build).
         CS8629 = unguarded .Value reads on scope resolution (reintroducing them fails the build). -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;CS8629</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Lets the published exe run as a Windows Service, so the API survives a reboot. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- `dotnet run` while an older copy of this API is still running used to fail: the old one holds
       Pos.Api.exe open ("file is locked by Pos.Api") and port 5288. Before building, close the copy
       running from this same output folder, so starting the API again always works.
       Only that folder: a Release build never touches a Debug backend, and a published service
       elsewhere is never touched. The test project opts out (KeepRunningCashlyApi), so running the
       tests never closes the backend you are using. -->
  <Target Name="StopRunningCashlyApi" BeforeTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' AND '$(DesignTimeBuild)' != 'true' AND '$(KeepRunningCashlyApi)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Get-Process -Name '$(AssemblyName)' -ErrorAction SilentlyContinue | Where-Object { $_.Path -and $_.Path.StartsWith('$(TargetDir)', [System.StringComparison]::OrdinalIgnoreCase) } | ForEach-Object { Write-Host ('Closing the Cashly backend still running (process ' + $_.Id + ') so the new one can start.'); Stop-Process -Id $_.Id -Force; $_.WaitForExit(10000) | Out-Null }&quot;"
          ContinueOnError="true" StandardOutputImportance="high" />
  </Target>

</Project>
