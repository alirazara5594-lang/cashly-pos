# Copy to .env and fill in real values before running `docker compose up`.
# Never commit the real .env file.

POSTGRES_DB=cashly_pos_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Long random string — e.g. `openssl rand -base64 48`
JWT_KEY=change-me-to-a-long-random-string

# Comma-separated list of extra allowed frontend origins, e.g. https://app.yourdomain.com
CORS_ORIGINS=

# Platform SuperAdmin login (Platform Admin -> sign-in toggle)
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PIN=change-me

# Where the frontend container should reach the API (build-time, baked into the static bundle)
VITE_API_BASE_URL=http://localhost:5288
